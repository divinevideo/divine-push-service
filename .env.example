# Log level (info, debug, trace)
RUST_LOG=info

# URL of the Nostr relay
NOSTR_PUSH__NOSTR__RELAY_URL=wss://relay.nostr.band

# Required: Private key for the service (for NIP-44 decryption)
NOSTR_PUSH__SERVICE__PRIVATE_KEY_HEX=your_service_private_key_hex_here

# Redis connection URL
REDIS_URL=redis://localhost:6379

# ============================================
# Campaign delivery collection (optional, off by default)
# ============================================

# NOSTR_PUSH__CAMPAIGN_DELIVERY__ENABLED=false
# Must be an https URL; the Access service token is attached to every request.
# NOSTR_PUSH__CAMPAIGN_DELIVERY__API_BASE_URL=
# NOSTR_PUSH__CAMPAIGN_DELIVERY__ACCESS_CLIENT_ID=
# NOSTR_PUSH__CAMPAIGN_DELIVERY__ACCESS_CLIENT_SECRET=
# Nothing is delivered until this is true. See README.
# NOSTR_PUSH__CAMPAIGN_DELIVERY__ALLOW_UNVERIFIED_CONSENT=false

# ============================================
# Firebase Credentials Configuration
# ============================================

# LOCAL DEVELOPMENT:
# Option 1: Explicit paths
NOSTR_PUSH__APPS__NOSTRPUSHDEMO__CREDENTIALS_PATH=./firebase-service-account-nostrpushdemo.json
NOSTR_PUSH__APPS__UNIVERSES__CREDENTIALS_PATH=./firebase-service-account-universes.json

# Option 2: Auto-detection (just place files with these exact names in project root):
# - firebase-service-account-nostrpushdemo.json
# - firebase-service-account-universes.json

# PRODUCTION (K8s):
# Credentials are mounted as files from secrets, so use:
# NOSTR_PUSH__APPS__NOSTRPUSHDEMO__CREDENTIALS_PATH=/app/secrets/firebase-nostrpushdemo.json
# NOSTR_PUSH__APPS__UNIVERSES__CREDENTIALS_PATH=/app/secrets/firebase-universes.json